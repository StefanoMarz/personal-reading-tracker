# URL pubblico del progetto, disponibile nelle impostazioni di Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Questa e la chiave pubblicabile per il browser, non la secret/service-role key.
# La sicurezza dei dati verra garantita anche dalle policy RLS del database.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
